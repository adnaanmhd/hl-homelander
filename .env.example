# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://humyn:humyn@localhost:5432/humyn_dev

# LocalStack (S3 + Secrets Manager)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
RECORDINGS_BUCKET=humyn-recordings-dev
APK_BUCKET=humyn-apk-dev
FEEDBACK_BUCKET=humyn-feedback-dev

# BullMQ broker for the hash-verify worker (the ONLY Redis use at MVP — see CLAUDE.md). In prod: the ElastiCache endpoint.
REDIS_URL=redis://localhost:6379

# JWT (HS256 — D-AUTH-04). For dev, set a fixed 32-byte base64 string.
# In prod, ECS injects from Secrets Manager (humyn/jwt/signing-secret).
JWT_SIGNING_SECRET=dev-only-do-not-use-in-prod-ee2c5b8c1a4f3d6e9c0b7a1d8e3f5b2a

# Google Sign-In (firebase project's Web OAuth client ID)
# In dev: set to a real Firebase project Web client ID, OR leave blank
# and the auth flow uses the integration-test stub.
GOOGLE_WEB_CLIENT_ID=

# Google Cloud Play Integrity service-account key JSON (single-line, single-quoted).
# Required at runtime for /auth/google to decode integrity tokens via googleapis
# playintegrity v1 (apps/api/src/auth/verify-play-integrity.ts). Service account
# needs `roles/serviceusage.serviceUsageConsumer` on the GCP project that hosts
# the Play Integrity API for the app's package. Smoke-walk recipe:
#   1. GCP Console → IAM → Service accounts (project number must match the
#      prefix of GOOGLE_WEB_CLIENT_ID above).
#   2. Create SA `humyn-play-integrity-decode` → grant Service Usage Consumer.
#   3. Keys → ADD KEY → JSON → save outside the repo (or to a *-iam.gserviceaccount.com.json
#      / *-<12-hex>.json filename — gitignored by default).
#   4. Inline the JSON content here (compact, single-line, single-quoted).
# In dev: blank → /auth/google 401s with `Play Integrity decode failed`.
PLAY_INTEGRITY_SA_KEY_JSON=

# Pattern 17 install-source bypass (D-AUTH-02). JSON object keyed by
# `auth.apk_install_source_bypass.<applicationId>` → boolean. Required for the
# apkRollout flavor to sign in (otherwise /auth/google 403s with
# `integrity-install-source` because the app was sideloaded, not installed
# from Play Store).
# Dev: '{"auth.apk_install_source_bypass.ai.humynlabs.capture.apk": true}'
# Prod: same key shape, sourced from Firebase Remote Config when Phase 5+ adds
#       Firebase Admin SDK; for Phase 1-2 it stays env-var-only (per CONTEXT.md).
REMOTE_CONFIG_JSON=

# CloudFront private key for recordings playback signing (PEM, single-line with \n)
# In dev: blank → /recordings/{id} returns the LocalStack URL directly.
CLOUDFRONT_RECORDINGS_PRIVATE_KEY=
CLOUDFRONT_RECORDINGS_KEY_PAIR_ID=
# CloudFront distribution base URL for recordings (e.g. https://recordings.humyn.ai)
# In dev: blank → /recordings/{id} falls back to the LocalStack S3 URL.
CLOUDFRONT_RECORDINGS_BASE_URL=

# Logging
LOG_LEVEL=info
NODE_ENV=development
