<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!--
      apkRollout flavor source set ONLY.
      REQUEST_INSTALL_PACKAGES is required by D-APK-02 for the in-app
      PackageInstaller forced-upgrade flow. The tools:targetApi annotation
      suppresses Android 14+ lint warnings on the same permission. Manifest
      merger merges this into the apkRollout APK; the playStore APK never
      sees this declaration.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
                     tools:targetApi="34" />
</manifest>
