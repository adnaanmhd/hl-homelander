<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Base manifest. Common permissions ONLY.
      NEVER add the in-app install-source permission here — Play Store auto-rejects
      APKs that declare it. The apkRollout flavor adds that permission via its own
      manifest source set at android/app/src/apkRollout/AndroidManifest.xml.

      EXPLICITLY DO NOT ADD (PROJECT.md hard rules):
        - The in-app install-source permission (apkRollout-only; flavor-scoped)
        - The post-notifications runtime permission (no notifications channel at MVP)
      The CI gate `apps/mobile/scripts/verify-merged-manifests.sh` enforces these
      absences on the merged manifest output of every flavor.

      ACCESS_FINE_LOCATION + ACCESS_COARSE_LOCATION are BOTH declared below.
      ⚠ Bug 3 / D3 (2026-06-04) — ACCESS_FINE_LOCATION OVERRIDES the formerly-
      LOCKED "coarse-only — no precise GPS" PROJECT.md hard rule (owner sign-off
      `.planning/260604-locked-override-signoff.md` D3). Precise lat/lng is now
      captured per recording, gated in onboarding (PermissionsScreen, D4) and
      acquired via the HumynLocation native module. The consent-text + DPIA
      review gate was WAIVED by the owner 2026-06-04 (consent text updated +
      consent version bumped 1.0.0 → 1.1.0 — precise GPS now ships). The
      verify-merged-manifests.sh FINE ban was lifted
      the same day.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 2 (PERM-04) — Camera + Mic capture, foreground service surfaces, wake lock. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- COMPAT-02 — IMU compat probe samples sensors at fastest rate (>200 Hz). Android 12+ (API 31+)
         requires this normal permission to be declared in the manifest; no runtime prompt fires.
         Without it, SensorManager.registerListener throws SecurityException and runCompatCheck
         silently rejects, routing the user to the empty CompatFailScreen. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Phase 5 (Plan 05-04) — background upload pipeline.
      - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: lets the app surface the AOSP
        battery-optimization-exemption prompt at first upload (UP-09) so the
        upload FGS isn't aggressively killed.
      - RUN_USER_INITIATED_JOBS: required to schedule a user-initiated data-transfer
        JobScheduler job (UploadJobService) for true-background uploads past the
        6 h `dataSync` FGS cap.
      The `UploadJobService` class itself ships in Plan 05-07; the <service>
      declaration below is the manifest half (an undeclared-but-referenced
      JobService class is harmless until something schedules it).
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />

    <!--
      Phase 6 Plan 06-01 (D-09 Wave 1) — explicit VIBRATE permission audit.
      RN's `Vibration` module's own manifest already declares this permission
      via the merged-manifest auto-merge, but per 06-RESEARCH.md "Pattern 8:
      Vibrator fix candidates" we declare it explicitly here so the merged
      manifest carries it regardless of RN library auto-merge timing on
      Android 16 / Pixel 10a. Normal-protection permission — granted at
      install without a runtime prompt; powers the `[100,50,100] ms` battery
      and 800 ms thermal-abort haptics from `useRecordingLifecycle.ts`.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Bug 3 / D3 + D4 (2026-06-04) — precise GPS location for each recording.
      ACCESS_FINE_LOCATION OVERRIDES the formerly-LOCKED coarse-only constraint
      (sign-off D3; consent text updated + version bumped 2026-06-04, owner
      waived the DPIA gate). COARSE stays declared so
      an "Approximate"-only grant on Android 12+ still yields a (coarser) fix
      rather than blocking (D3 partial-grant handling). Gated in onboarding
      (PermissionsScreen, D4 — block-until-granted) and acquired via the
      HumynLocation native module (FusedLocationProviderClient).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Phase 2 hardware-feature filters — Play Store uses these to filter
      incompatible devices before install. `required="true"` on each is
      mandatory because the locked capture spec depends on all three.
    -->
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />

    <!--
      Debug session `humyncapture-imu-oom-rollover` (2026-05-18) —
      `android:largeHeap="true"` is defense-in-depth on top of the primitive-
      buffer refactor in PrimitiveLongBuffer.kt / ImuWriter.kt / CaptureSession.kt
      that eliminated the per-IMU-sample and per-video-frame autoboxing on the
      recording hot path. The primary fix (allocation elimination) is what
      actually keeps the heap quiet across 7+ continuous 10-min segments on
      Pixel-class hardware; `largeHeap` raises the Dalvik growth limit from
      ~256 MB to ~512 MB on most Pixel devices so any residual allocation
      pattern we may not have caught has 2× the headroom before OOM. Granted
      app-wide because the recording session, Hermes JS heap, RN bridge, and
      Camera2 image-buffer pool all share the process heap.
    -->
    <application
        android:name=".MainApplication"
        android:label="Humyn Labs Capture"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Phase 3 D-FGS-01 (plan 03-07) — capture foreground service.
          Pitfall 6 strict-mode: foregroundServiceType MUST exactly equal
          HumynForegroundService.FGS_TYPE_RECORDING bitmask
          (FOREGROUND_SERVICE_TYPE_CAMERA | _MICROPHONE | _DATA_SYNC).
          Two-sided lock: manifests.test.ts (static) + HumynForegroundServiceTest
          (runtime) both fail if either side drifts.
        -->
        <service
            android:name=".fgs.HumynForegroundService"
            android:foregroundServiceType="camera|microphone|dataSync"
            android:exported="false" />

        <!--
          Phase 5 (Plan 05-04) — user-initiated data-transfer JobService for
          true-background uploads past the 6 h `dataSync` FGS cap. The class
          ships in Plan 05-07; only JobScheduler can bind it
          (exported=false + BIND_JOB_SERVICE).
        -->
        <service
            android:name=".upload.UploadJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>
</manifest>
