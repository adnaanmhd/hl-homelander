<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Base manifest. Common permissions ONLY.
      NEVER add the in-app install-source permission here — Play Store auto-rejects
      APKs that declare it. The apkRollout flavor adds that permission via its own
      manifest source set at android/app/src/apkRollout/AndroidManifest.xml.

      EXPLICITLY DO NOT ADD (PROJECT.md hard rules):
        - The in-app install-source permission (apkRollout-only; flavor-scoped)
        - The post-notifications runtime permission (no notifications channel at MVP)
        - The fine-location runtime permission (coarse-only; PROJECT.md hard rule)
      The CI gate `apps/mobile/scripts/verify-merged-manifests.sh` enforces these
      absences on the merged manifest output of every flavor.

      ACCESS_COARSE_LOCATION (PERM-03) IS DECLARED below per plan 02-14. The
      runtime PROMPT is still deferred to Phase 4 (first-recording flow), but
      the manifest declaration must ship now so the helper at
      apps/mobile/src/services/locationPermission.ts has a permission to query.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 2 (PERM-04) — Camera + Mic capture, foreground service surfaces, wake lock. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- COMPAT-02 — IMU compat probe samples sensors at fastest rate (>200 Hz). Android 12+ (API 31+)
         requires this normal permission to be declared in the manifest; no runtime prompt fires.
         Without it, SensorManager.registerListener throws SecurityException and runCompatCheck
         silently rejects, routing the user to the empty CompatFailScreen. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Phase 2 (PERM-03 — plan 02-14) — coarse location declaration ONLY.
      Runtime prompt is deferred to Phase 4's first-recording flow via
      apps/mobile/src/services/locationPermission.ts (requestCoarseLocation).
      PROJECT.md hard rule: coarse only — never declare ACCESS_FINE_LOCATION.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Phase 2 hardware-feature filters — Play Store uses these to filter
      incompatible devices before install. `required="true"` on each is
      mandatory because the locked capture spec depends on all three.
    -->
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />

    <application
        android:name=".MainApplication"
        android:label="Humyn Labs Capture"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Phase 3 D-FGS-01 (plan 03-07) — capture foreground service.
          Pitfall 6 strict-mode: foregroundServiceType MUST exactly equal
          HumynForegroundService.FGS_TYPE_RECORDING bitmask
          (FOREGROUND_SERVICE_TYPE_CAMERA | _MICROPHONE | _DATA_SYNC).
          Two-sided lock: manifests.test.ts (static) + HumynForegroundServiceTest
          (runtime) both fail if either side drifts.
        -->
        <service
            android:name=".fgs.HumynForegroundService"
            android:foregroundServiceType="camera|microphone|dataSync"
            android:exported="false" />
    </application>
</manifest>
