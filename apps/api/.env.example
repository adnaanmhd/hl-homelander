# This mirrors the root .env.example. The api package reads DATABASE_URL +
# AWS_* + JWT_SIGNING_SECRET + GOOGLE_WEB_CLIENT_ID + PLAY_INTEGRITY_SA_KEY_JSON
# + RECORDINGS_BUCKET + APK_BUCKET + CLOUDFRONT_* directly.
# Source-of-truth for the env contract is /.env.example at the repo root.

DATABASE_URL=postgres://humyn:humyn@localhost:5432/humyn_dev
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
RECORDINGS_BUCKET=humyn-recordings-dev
APK_BUCKET=humyn-apk-dev
FEEDBACK_BUCKET=humyn-feedback-dev
JWT_SIGNING_SECRET=dev-only-do-not-use-in-prod-ee2c5b8c1a4f3d6e9c0b7a1d8e3f5b2a
GOOGLE_WEB_CLIENT_ID=
PLAY_INTEGRITY_SA_KEY_JSON=
# Pattern 17 install-source bypass (D-AUTH-02). JSON object keyed by
# `auth.apk_install_source_bypass.<applicationId>` → boolean. apkRollout
# sign-in 403s with `integrity-install-source` when this key is missing/false.
# Dev: '{"auth.apk_install_source_bypass.ai.humynlabs.capture.apk": true}'
# Prod: same key shape, sourced from Firebase Remote Config in Phase 5+.
REMOTE_CONFIG_JSON=
CLOUDFRONT_RECORDINGS_PRIVATE_KEY=
CLOUDFRONT_RECORDINGS_KEY_PAIR_ID=
CLOUDFRONT_RECORDINGS_BASE_URL=
LOG_LEVEL=info
NODE_ENV=development
