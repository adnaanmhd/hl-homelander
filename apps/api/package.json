{
  "name": "@humyn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:tasks": "tsx scripts/seed-tasks.ts",
    "legal:hash": "tsx scripts/legal-hash.ts",
    "dsr:build-export": "tsx scripts/dsr-export.ts",
    "worker:hash-verify": "node dist/workers/hash-verify.js",
    "worker:hash-verify:dev": "tsx watch src/workers/hash-verify.ts"
  },
  "dependencies": {
    "@humyn/shared-types": "workspace:*",
    "bullmq": "5.76.8",
    "ioredis": "5.10.1",
    "fastify": "5.8.5",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "6.1.0",
    "nanoid": "5.0.9",
    "@fastify/cors": "11.2.0",
    "@fastify/jwt": "10.0.0",
    "@fastify/multipart": "9.0.3",
    "@fastify/rate-limit": "10.3.0",
    "pino": "10.3.1",
    "pino-pretty": "13.0.0",
    "pg": "8.20.0",
    "drizzle-orm": "0.45.2",
    "google-auth-library": "10.6.2",
    "googleapis": "144.0.0",
    "@aws-sdk/client-s3": "3.1044.0",
    "@aws-sdk/s3-request-presigner": "3.1044.0",
    "@aws-sdk/client-sqs": "3.1044.0",
    "@aws-sdk/client-secrets-manager": "3.1044.0",
    "@aws-sdk/cloudfront-signer": "3.1036.0",
    "@xenova/transformers": "2.17.2",
    "zod": "4.4.3",
    "ulid": "2.3.0",
    "lru-cache": "11.0.2"
  },
  "devDependencies": {
    "@types/node": "22.9.3",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "drizzle-kit": "0.28.1",
    "vitest": "4.1.5",
    "eslint": "9.16.0",
    "@typescript-eslint/parser": "8.18.0",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "jsonwebtoken": "9.0.2",
    "@types/jsonwebtoken": "9.0.7",
    "form-data": "4.0.1"
  }
}
