# OS
.DS_Store

# Local agent / tooling state (GSD framework, machine-specific settings, transcripts)
.claude/
.planning/.local-stash/

# Local scratch notes (working docs not meant for the repo)
temp.md

# Reverse-engineering reference scratch — the Figure "Minutes" APK is NOT ours;
# do not commit it (third-party IP + GitHub's 100 MB/file limit). Decompiled /
# extracted trees, any stray APKs, and local screen-recordings stay out of git.
*.apk
apk-extracted/
jadx-out/
landscape_enforcement.mp4

# Test / coverage
coverage/
.vitest-temp/

# Mobile signing & native
# Ignore everything inside keystores/ EXCEPT the directory's own .gitignore so
# the directory exists in the repo (real keystores arrive at CI runtime via
# decrypted secrets). Defense-in-depth alongside apps/mobile/android/keystores/.gitignore.
apps/mobile/android/keystores/*
!apps/mobile/android/keystores/.gitignore
apps/mobile/ios/Pods/

# Terraform local state (do not check in keep root reference)
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate*
infra/terraform/**/.terraform.lock.hcl

# ONNX / ML model cache
models/

# DSR access/portability export bundles (ops CLI output; per-user PII — never commit)
apps/api/dsr-exports/

# Phase 7: tools workspace secrets — never commit
tools/.env
tools/node_modules/

# Hardware walk artifacts (driven by WALK.md). Screencaps, logcat slices, recording
# clips, and intermediate logs stay local. Only the curated REPORT.md per walk is
# tracked. Git can't re-include children of a fully-ignored parent, so we ignore
# walks/**/ (files) and explicitly un-ignore the dirs + REPORT.md.
/walks/**
!/walks/
!/walks/*/
!/walks/*/REPORT.md

