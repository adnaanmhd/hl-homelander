# Firebase config (per-developer; download via Firebase Console, do not commit)
apps/mobile/android/app/google-services.json
apps/mobile/android/app/src/*/google-services.json
apps/mobile/android/app/src/main/google-services*.json

# Google Cloud service-account JSON keys (per-developer; contain private keys)
# Pattern matches the GCP-default download filename (e.g. homelander-24045-1184f935e587.json)
*-iam.gserviceaccount.com.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

