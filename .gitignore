# Dependencies
node_modules/

# Build artifacts
dist/
*.tsbuildinfo
apps/api/dist/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/
apps/mobile/android/app/.cxx/
apps/mobile/android/local.properties
apps/mobile/android/.idea/
apps/mobile/.vscode/
apps/mobile/android/.vscode/

# Firebase config (per-developer; download via Firebase Console, do not commit)
apps/mobile/android/app/google-services.json
apps/mobile/android/app/src/*/google-services.json
apps/mobile/android/app/src/main/google-services*.json

# Google Cloud service-account JSON keys (per-developer; contain private keys)
# Pattern matches the GCP-default download filename (e.g. homelander-24045-1184f935e587.json)
*-iam.gserviceaccount.com.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# Environment
.env
.env.local

# OS
.DS_Store

# Test / coverage
coverage/
.vitest-temp/

# Mobile signing & native
# Ignore everything inside keystores/ EXCEPT the directory's own .gitignore so
# the directory exists in the repo (real keystores arrive at CI runtime via
# decrypted secrets). Defense-in-depth alongside apps/mobile/android/keystores/.gitignore.
apps/mobile/android/keystores/*
!apps/mobile/android/keystores/.gitignore
apps/mobile/ios/Pods/

# Terraform local state (do not check in keep root reference)
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate*
infra/terraform/**/.terraform.lock.hcl

# ONNX / ML model cache
models/

# DSR access/portability export bundles (ops CLI output; per-user PII — never commit)
apps/api/dsr-exports/
