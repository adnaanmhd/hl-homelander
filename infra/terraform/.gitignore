# Terraform state — NEVER commit. Lives in S3 backend.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local provider caches + lock files generated by `terraform init`
.terraform/
.terraform.lock.hcl

# Plan artifacts — generated by `terraform plan -out`
*.tfplan
crash.log

# Override files (Terraform reads these automatically; never commit)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI rc / credentials
.terraformrc
terraform.rc

# Local-only var overrides — auto-loaded by Terraform; never commit
*.auto.tfvars
*.auto.tfvars.json
