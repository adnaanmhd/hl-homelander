#!/usr/bin/env sh

# Pre-commit hook scoped to the post-Phase-2-plan-01 split:
#  - apps/mobile is npm-only (D-PKG-01..07): its own lint-staged config
#    will live there once plan 02-13 lands. Until then, mobile-staged
#    files are not run through lint-staged; they still go through any
#    per-file checks the developer adds inside apps/mobile.
#  - Backend (apps/api) and shared/* are pnpm-managed: continue to use
#    root pnpm exec lint-staged + pnpm typecheck.
#
# Decision branches on whether any staged file lives under apps/mobile/.
# If yes AND apps/mobile/package.json declares a "lint-staged" field:
# cd in and run `npx --no-install lint-staged --concurrent false`.
# Otherwise we skip the mobile lint-staged invocation (no config yet).
#
# This is the simplest safe shape; richer per-package routing is a
# Phase 2 polish task (planner-level inside plan 02-13).

# 1. Root lint-staged (covers shared/*, apps/api, root configs).
pnpm exec lint-staged

# 2. Mobile-side lint-staged, only when a mobile file is staged AND a
#    lint-staged config exists in apps/mobile.
STAGED_MOBILE=$(git diff --cached --name-only --diff-filter=ACMR | grep '^apps/mobile/' || true)
if [ -n "$STAGED_MOBILE" ]; then
  if node -e "process.exit(require('./apps/mobile/package.json')['lint-staged'] ? 0 : 1)" 2>/dev/null; then
    (cd apps/mobile && npx --no-install lint-staged --concurrent false)
  fi
fi

# 3. Root typecheck across the pnpm workspace (apps/api + shared/*).
#    Mobile typecheck is invoked separately via `npm run typecheck` from
#    inside apps/mobile (or the root `mobile:typecheck` script).
pnpm typecheck
